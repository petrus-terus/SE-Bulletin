# Sabah Electricity Bulletin - Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Supabase Backend Configuration (Phase 1 Pilot)
# -----------------------------------------------------------------------------
# If left empty, the application automatically and gracefully falls back to 
# rich offline/mock corporate data in src/services/mockData.ts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Local HTTPS / Basic SSL (Optional)
# -----------------------------------------------------------------------------
# Set to 'true' if testing PWA home-screen installation on iOS devices over LAN.
# Default: false (HTTP on port 3001)
VITE_SSL=false
